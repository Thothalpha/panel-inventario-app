# Solo para desarrollo. En la app de macOS todo se configura desde la pantalla de
# configuración y las claves se guardan en el Llavero, no en este archivo.

# --- Odoo (solo lectura) ---
ODOO_URL=https://miempresa.odoo.com
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=

# --- IA ---
# AI_PROVIDER=openrouter        # openrouter | openai | anthropic | custom
# AI_MODEL=deepseek/deepseek-v4-flash
# AI_BASE_URL=                  # solo para "custom" (p. ej. http://localhost:11434/v1)
AI_API_KEY=

# --- Panel en modo servidor (opcional) ---
# DEMO_MODE=1                 # datos de demo en vez de Odoo
# DEMO_SOURCE=ficticio        # con DEMO_MODE=1: datos ficticios
# CACHE_TTL_SECONDS=900       # cada cuánto se vuelve a leer Odoo
# DASH_USER=usuario           # si se define, el panel pide usuario/contraseña
# DASH_PASSWORD=
